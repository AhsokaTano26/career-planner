# career-ai 环境变量示例：复制为 .env 并按需修改（.env 不入库）

# ---------------------------------------------------------------- 大模型渠道（OpenAI 兼容）
LLM_API_KEY=sk-xxxx                    # DeepSeek 渠道密钥（网关渠道之一）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ---------------------------------------------------------------- AI 网关（gateway/*）
GATEWAY_API_KEY=gw-change-me           # 网关内部鉴权（career-core 携带 Bearer <key>）
# 模型组与 fallback 链（JSON 数组；fallbacks 非空时主通道失败自动切备用，ai_call_log 记 DEGRADED + scene 后缀）
# 例（双通道）：GATEWAY_MODEL_GROUPS=[{"group":"default","models":["deepseek/deepseek-v4-flash"],"fallbacks":["openai/gpt-4o-mini"]}]
GATEWAY_MODEL_GROUPS=[{"group":"default","models":["deepseek/deepseek-v4-flash"],"fallbacks":[]}]
GATEWAY_RPM=60                         # 每分钟最大请求数（进程内令牌桶）
GATEWAY_TIMEOUT=30                     # 单次调用超时（秒）
GATEWAY_MAX_RETRIES=2                  # 失败重试次数（指数退避）
# 生产化（2026-09，可选；空=不限，保持旧行为）
GATEWAY_SCENE_MAX_TOKENS={"career_chat":2000,"recommendation_explain":2000,"plan_generate":2000,"review_summarize":1500,"gateway_api":500}
GATEWAY_DAILY_TOKEN_BUDGET={"recommendation_explain":200000,"*":1000000}
GATEWAY_EXPLAIN_CACHE=1                # 推荐解释 identical prompt 缓存（0 关闭）
GATEWAY_EXPLAIN_CACHE_TTL=3600         # 缓存秒
GATEWAY_EXPLAIN_CACHE_MAXSIZE=256      # 缓存条数

# ---------------------------------------------------------------- ai_call_log 落库（仅写日志表）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=career
DB_PASSWORD=change-me
DB_NAME=career_core
