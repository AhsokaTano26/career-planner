# 环境变量示例：部署时复制为 .env 并按需修改（真实密码勿写入本文件）
MYSQL_ROOT_PASSWORD=<your-root-password>
MYSQL_DATABASE=career_core
MYSQL_USER=career
MYSQL_PASSWORD=<your-app-password>

# AI 服务（career-ai 网关渠道凭据；模型名默认 deepseek-v4-flash）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=deepseek-v4-flash

# AI 网关（2026-08-29 起：career-core 全量大模型调用经 career-ai 网关）
# 网关内部鉴权密钥（career-core 与 career-ai 共用此值）
GATEWAY_API_KEY=<generate-a-random-secret>
# 模型组与 fallback 链（可选 JSON；缺省用 career-ai/.env 或内置 DeepSeek 默认值）
GATEWAY_MODEL_GROUPS=
GATEWAY_RPM=60
GATEWAY_TIMEOUT=30
GATEWAY_MAX_RETRIES=2
