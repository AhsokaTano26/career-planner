<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rickgao.careercore.modules.admin.mapper.AiCallLogMapper">

    <resultMap id="AiCallLogMap" type="com.rickgao.careercore.modules.admin.entity.AiCallLog">
        <id property="id" column="id"/>
        <result property="requestId" column="request_id"/>
        <result property="userRef" column="user_ref"/>
        <result property="scene" column="scene"/>
        <result property="modelName" column="model_name"/>
        <result property="promptVersion" column="prompt_version"/>
        <result property="durationMs" column="duration_ms"/>
        <result property="status" column="status"/>
        <result property="tokenEstimate" column="token_estimate"/>
        <result property="requestHash" column="request_hash"/>
        <result property="inputHash" column="input_hash"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.rickgao.careercore.modules.admin.entity.AiCallLog">
        INSERT INTO ai_call_log
          (id, request_id, user_ref, scene, model_name, prompt_version, duration_ms,
           status, token_estimate, request_hash, input_hash)
        VALUES
          (#{id}, #{requestId}, #{userRef}, #{scene}, #{modelName}, #{promptVersion}, #{durationMs},
           #{status}, #{tokenEstimate}, #{requestHash}, #{inputHash})
    </insert>

</mapper>

