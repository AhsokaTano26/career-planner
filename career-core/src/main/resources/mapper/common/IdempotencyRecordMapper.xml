<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rickgao.careercore.common.idempotency.IdempotencyRecordMapper">

    <resultMap id="IdempotencyRecordMap" type="com.rickgao.careercore.common.idempotency.IdempotencyRecord">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="endpoint" column="endpoint"/>
        <result property="requestKey" column="request_key"/>
        <result property="requestHash" column="request_hash"/>
        <result property="status" column="status"/>
        <result property="responseCode" column="response_code"/>
        <result property="responseBody" column="response_body"/>
        <result property="createdAt" column="created_at"/>
        <result property="expiresAt" column="expires_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.rickgao.careercore.common.idempotency.IdempotencyRecord">
        INSERT INTO idempotency_record (id, user_id, endpoint, request_key, status)
        VALUES (#{id}, #{userId}, #{endpoint}, #{requestKey}, #{status})
    </insert>

    <select id="findByUserEndpointKey" resultMap="IdempotencyRecordMap">
        SELECT id, user_id, endpoint, request_key, request_hash, status,
               response_code, response_body, created_at, expires_at
        FROM idempotency_record
        WHERE user_id = #{userId}
          AND endpoint = #{endpoint}
          AND request_key = #{requestKey}
        LIMIT 1
    </select>

    <update id="markSuccess">
        UPDATE idempotency_record
        SET status = 'SUCCESS',
            response_code = #{code},
            response_body = #{body}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM idempotency_record WHERE id = #{id}
    </delete>

</mapper>
